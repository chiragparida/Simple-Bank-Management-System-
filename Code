import sqlite3
from datetime import datetime, timedelta


class Library:
    def __init__(self, database="library.db"):
        self.conn = sqlite3.connect(database)
        self.cursor = self.conn.cursor()
        self.create_tables()

    def create_tables(self):
        self.cursor.execute("""
            CREATE TABLE IF NOT EXISTS books (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                title TEXT NOT NULL,
                author TEXT NOT NULL,
                category TEXT,
                quantity INTEGER DEFAULT 1,
                available INTEGER DEFAULT 1
            )
        """)

        self.cursor.execute("""
            CREATE TABLE IF NOT EXISTS members (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                email TEXT UNIQUE NOT NULL,
                phone TEXT
            )
        """)

        self.cursor.execute("""
            CREATE TABLE IF NOT EXISTS transactions (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                book_id INTEGER,
                member_id INTEGER,
                issue_date TEXT,
                due_date TEXT,
                return_date TEXT,
                fine REAL DEFAULT 0,
                FOREIGN KEY(book_id) REFERENCES books(id),
                FOREIGN KEY(member_id) REFERENCES members(id)
            )
        """)

        self.conn.commit()

    # ---------------- BOOK MANAGEMENT ----------------

    def add_book(self, title, author, category, quantity):
        self.cursor.execute("""
            INSERT INTO books
            (title, author, category, quantity, available)
            VALUES (?, ?, ?, ?, ?)
        """, (title, author, category, quantity, quantity))

        self.conn.commit()
        print("\nBook added successfully!")

    def remove_book(self, book_id):
        self.cursor.execute(
            "DELETE FROM books WHERE id = ?",
            (book_id,)
        )

        if self.cursor.rowcount == 0:
            print("\nBook not found!")
        else:
            self.conn.commit()
            print("\nBook removed successfully!")

    def display_books(self):
        self.cursor.execute("SELECT * FROM books")
        books = self.cursor.fetchall()

        print("\n" + "=" * 80)
        print("LIBRARY BOOKS")
        print("=" * 80)

        if not books:
            print("No books available.")
            return

        for book in books:
            print(
                f"ID: {book[0]} | "
                f"Title: {book[1]} | "
                f"Author: {book[2]} | "
                f"Category: {book[3]} | "
                f"Available: {book[5]}/{book[4]}"
            )

    def search_book(self, keyword):
        self.cursor.execute("""
            SELECT * FROM books
            WHERE title LIKE ?
               OR author LIKE ?
               OR category LIKE ?
        """, (
            f"%{keyword}%",
            f"%{keyword}%",
            f"%{keyword}%"
        ))

        books = self.cursor.fetchall()

        print("\nSEARCH RESULTS")
        print("-" * 80)

        if not books:
            print("No books found.")
            return

        for book in books:
            print(
                f"ID: {book[0]} | "
                f"{book[1]} | "
                f"Author: {book[2]} | "
                f"Available: {book[5]}/{book[4]}"
            )

    # ---------------- MEMBER MANAGEMENT ----------------

    def add_member(self, name, email, phone):
        try:
            self.cursor.execute("""
                INSERT INTO members
                (name, email, phone)
                VALUES (?, ?, ?)
            """, (name, email, phone))

            self.conn.commit()
            print("\nMember registered successfully!")

        except sqlite3.IntegrityError:
            print("\nEmail already registered!")

    def display_members(self):
        self.cursor.execute("SELECT * FROM members")
        members = self.cursor.fetchall()

        print("\n" + "=" * 70)
        print("LIBRARY MEMBERS")
        print("=" * 70)

        if not members:
            print("No members registered.")
            return

        for member in members:
            print(
                f"ID: {member[0]} | "
                f"Name: {member[1]} | "
                f"Email: {member[2]} | "
                f"Phone: {member[3]}"
            )

    # ---------------- ISSUE BOOK ----------------

    def issue_book(self, book_id, member_id):

        self.cursor.execute(
            "SELECT available FROM books WHERE id = ?",
            (book_id,)
        )

        book = self.cursor.fetchone()

        if not book:
            print("\nBook not found!")
            return

        if book[0] <= 0:
            print("\nBook is currently unavailable!")
            return

        self.cursor.execute(
            "SELECT id FROM members WHERE id = ?",
            (member_id,)
        )

        member = self.cursor.fetchone()

        if not member:
            print("\nMember not found!")
            return

        issue_date = datetime.now()
        due_date = issue_date + timedelta(days=14)

        self.cursor.execute("""
            INSERT INTO transactions
            (book_id, member_id, issue_date, due_date)
            VALUES (?, ?, ?, ?)
        """, (
            book_id,
            member_id,
            issue_date.strftime("%Y-%m-%d"),
            due_date.strftime("%Y-%m-%d")
        ))

        self.cursor.execute("""
            UPDATE books
            SET available = available - 1
            WHERE id = ?
        """, (book_id,))

        self.conn.commit()

        print("\nBook issued successfully!")
        print("Issue Date:", issue_date.strftime("%Y-%m-%d"))
        print("Due Date:", due_date.strftime("%Y-%m-%d"))

    # ---------------- RETURN BOOK ----------------

    def return_book(self, transaction_id):

        self.cursor.execute("""
            SELECT book_id, due_date, return_date
            FROM transactions
            WHERE id = ?
        """, (transaction_id,))

        transaction = self.cursor.fetchone()

        if not transaction:
            print("\nTransaction not found!")
            return

        book_id, due_date, return_date = transaction

        if return_date:
            print("\nBook has already been returned!")
            return

        today = datetime.now().date()
        due = datetime.strptime(due_date, "%Y-%m-%d").date()

        overdue_days = max((today - due).days, 0)

        # Fine = ₹5 per overdue day
        fine = overdue_days * 5

        self.cursor.execute("""
            UPDATE transactions
            SET return_date = ?, fine = ?
            WHERE id = ?
        """, (
            today.strftime("%Y-%m-%d"),
            fine,
            transaction_id
        ))

        self.cursor.execute("""
            UPDATE books
            SET available = available + 1
            WHERE id = ?
        """, (book_id,))

        self.conn.commit()

        print("\nBook returned successfully!")
        print("Overdue Days:", overdue_days)
        print("Fine: ₹", fine)

    # ---------------- TRANSACTIONS ----------------

    def display_transactions(self):

        self.cursor.execute("""
            SELECT
                transactions.id,
                books.title,
                members.name,
                transactions.issue_date,
                transactions.due_date,
                transactions.return_date,
                transactions.fine
            FROM transactions
            JOIN books
                ON transactions.book_id = books.id
            JOIN members
                ON transactions.member_id = members.id
        """)

        transactions = self.cursor.fetchall()

        print("\n" + "=" * 100)
        print("TRANSACTION HISTORY")
        print("=" * 100)

        if not transactions:
            print("No transactions found.")
            return

        for t in transactions:
            status = "Returned" if t[5] else "Issued"

            print(
                f"Transaction ID: {t[0]} | "
                f"Book: {t[1]} | "
                f"Member: {t[2]} | "
                f"Issue: {t[3]} | "
                f"Due: {t[4]} | "
                f"Return: {t[5]} | "
                f"Fine: ₹{t[6]} | "
                f"Status: {status}"
            )

    def close(self):
        self.conn.close()


# =====================================================
# MAIN PROGRAM
# =====================================================

def main():

    library = Library()

    while True:

        print("\n")
        print("=" * 50)
        print("       LIBRARY MANAGEMENT SYSTEM")
        print("=" * 50)

        print("1. Add Book")
        print("2. Remove Book")
        print("3. Display Books")
        print("4. Search Book")
        print("5. Add Member")
        print("6. Display Members")
        print("7. Issue Book")
        print("8. Return Book")
        print("9. Transaction History")
        print("10. Exit")

        choice = input("\nEnter your choice: ")

        if choice == "1":

            title = input("Enter book title: ")
            author = input("Enter author: ")
            category = input("Enter category: ")
            quantity = int(input("Enter quantity: "))

            library.add_book(
                title,
                author,
                category,
                quantity
            )

        elif choice == "2":

            book_id = int(input("Enter book ID: "))
            library.remove_book(book_id)

        elif choice == "3":

            library.display_books()

        elif choice == "4":

            keyword = input(
                "Enter title/author/category to search: "
            )

            library.search_book(keyword)

        elif choice == "5":

            name = input("Enter member name: ")
            email = input("Enter email: ")
            phone = input("Enter phone: ")

            library.add_member(
                name,
                email,
                phone
            )

        elif choice == "6":

            library.display_members()

        elif choice == "7":

            book_id = int(input("Enter book ID: "))
            member_id = int(input("Enter member ID: "))

            library.issue_book(
                book_id,
                member_id
            )

        elif choice == "8":

            transaction_id = int(
                input("Enter transaction ID: ")
            )

            library.return_book(
                transaction_id
            )

        elif choice == "9":

            library.display_transactions()

        elif choice == "10":

            library.close()
            print("\nThank you for using the Library Management System!")
            break

        else:

            print("\nInvalid choice. Please try again.")


if __name__ == "__main__":
    main()
